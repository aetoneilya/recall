# Copy to .env (local dev) or /etc/recall/recall.env (server). Never commit.

# SQLite file; the server creates it.
DB_PATH=./recall.db
PORT=8080
# 127.0.0.1 behind nginx; empty = all interfaces.
HOST=
# Public origin: OAuth issuer for claude.ai and the Telegram Mini App URL.
APP_ORIGIN=https://cards.example.com

# Telegram: bot from @BotFather. Bot (and Telegram sign-in) is off without BOT_TOKEN.
BOT_TOKEN=
# The admin's numeric Telegram id. Required once the DB has data: the
# multi-user migration assigns the existing collection to this user.
OWNER_TELEGRAM_ID=
# Other Telegram ids allowed in, comma-separated (each gets their own collection).
# Strangers are refused; the bot tells them their id so they can ask.
ALLOW_USER_IDS=

# Owner-only password fallback for when Telegram is unreachable.
OWNER_PASSWORD=
# Legacy static bearer for the owner's Claude Code; other users create
# personal tokens (mn_…) in Settings. Generate: openssl rand -hex 32
MCP_TOKEN=

# Study day starts at DAY_START_HOUR local time (global).
DAY_START_HOUR=4
# Defaults for new users; each user sets their own zone and times in the app.
TZ_NAME=Europe/Moscow
# Telegram reminders, local time; evening one only if nothing was reviewed today.
REMINDER_TIME=09:00
EVENING_REMINDER_TIME=20:00

# Built web app; set in production.
STATIC_DIR=

# ✨ autofill (Claude API). Off without a key. Also fills in words sent to
# the bot and picks words from pasted text and photos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Claude calls per user per study day: autofill, each word added via the bot,
# one per paragraph/photo the bot picks words from.
AUTOFILL_DAILY_LIMIT=200
# Frequency list and vocabulary-test data; default server/data.
DATA_DIR=

# Per-user FSRS weights are trained (weekly, or POST /api/fsrs/optimize)
# once a user has this many usable reviews.
FSRS_MIN_REVIEWS=1000
